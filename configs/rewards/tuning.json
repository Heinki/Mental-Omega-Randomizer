{
  "schema_version": 1,
  "description": "Editable reward stacking, clone construction, retry assistance, and reward-planning tuning. Stat caps clamp the final useful stack to the exact remaining effect; planning reallocates later reward slots.",
  "sections": {
    "buff_effects": {
      "production": {"factor_per_stack": 0.85, "minimum_multiplier": 0.2, "stack_limit": 10},
      "cost": {"factor_per_stack": 0.8, "minimum_multiplier": 0.0, "stack_limit": 24},
      "speed": {"factor_per_stack": 1.1},
      "armor": {"factor_per_stack": 0.9, "minimum_multiplier": 0.09090909090909091, "stack_limit": 23},
      "health": {"factor_per_stack": 1.15, "maximum_multiplier": 11.0, "stack_limit": 18},
      "damage": {"factor_per_stack": 1.15},
      "reload": {"factor_per_stack": 0.9},
      "range": {"amount_per_stack": 0.5, "maximum_amount": 50.0, "stack_limit": 100},
      "sight": {"amount_per_stack": 1, "maximum_amount": 100, "stack_limit": 100},
      "ammo": {"amount_per_stack": 1},
      "sensor_sight_bonus": 2,
      "defense_self_heal_fraction": 0.01,
      "maximum_self_heal_fraction": 0.5,
      "movement_speed": {
        "safe_ceilings": {
          "infantry": 8,
          "units": 12,
          "aircraft": 30
        }
      }
    },
    "clone_policy": {
      "unit_id_prefix": "MORP",
      "weapon_id_prefix": "MORW",
      "production_gate_keys": ["techlevel", "buildlimit", "prerequisite", "prerequisiteoverride", "prerequisite.negative", "prerequisite.stolentechs", "factoryowners", "factoryowners.forbidden", "builtat"],
      "production_gate_prefixes": ["prerequisite.list"],
      "required_weapon_fields": ["Projectile", "Warhead"]
    },
    "mission_assistance": {
      "direct_buff_types": ["health", "damage", "range"],
      "reload_when_weapon_rof_above": 1,
      "add_safe_movement_speed": true
    },
    "reward_planning": {
      "default_rewards_per_check": 1,
      "maximum_rewards_per_check": 30,
      "global_buff_reward_interval": 10
    }
  }
}
